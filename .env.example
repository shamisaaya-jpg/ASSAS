# Copy to .env and change every value.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://assas:change-me@localhost:5432/assas
OPENSEARCH_URL=http://localhost:9200

# Set to 1 only when ASSAS is served over HTTPS
SESSION_COOKIE_SECURE=0
# Never enable on a machine others can reach (the debugger allows code execution)
FLASK_DEBUG=0
